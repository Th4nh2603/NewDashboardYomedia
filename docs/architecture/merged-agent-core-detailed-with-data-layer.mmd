  classDef tool fill:#fff7ed,stroke:#f97316,color:#431407;
  classDef data fill:#f8fafc,stroke:#475569,color:#0f172a;
  classDef storage fill:#ecfeff,stroke:#0891b2,color:#164e63;
  classDef approval fill:#fff1f2,stroke:#e11d48,color:#4c0519;

  class Manage,ChatUI,Rpc frontend;
  class ChatAPI,Context,Branches backend;
  class Runtime,Orchestrator,Skills,Memory,Intent,Registry,SystemPrompt,Loop core;
  class Policy,Validate,Permission,Scope,Envelope,RAG,RagService,SQL,SqlSafety policy;
  class ToolCapability,ToolRegistry,ToolName,LoadSkill,ToolInput,ToolPerm,ToolScope,ApprovalCheck,Sanitizer,Execution,Executor,SftpTools tool;
  class AppDB,Knowledge,ReportDB,LogStore,Data data;
  class SftpService,Secrets storage;
  class Approval,HITL,ApprovalDto,ApprovalState approval;
